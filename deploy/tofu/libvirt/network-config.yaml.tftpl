version: 2
ethernets:
  primary:
    match:
      macaddress: "${mac}"
    addresses: [${address}]
    routes:
      - to: ${strcontains(gateway, ":") ? "::/0" : "0.0.0.0/0"}
        via: ${gateway}
    nameservers:
      addresses: [${join(", ", dns)}]
%{ if length(search) > 0 ~}
      search: [${join(", ", search)}]
%{ endif ~}
