# A cluster of four VMs on three KVM hosts with Open vSwitch (docs/platform.md §8): three servers,
# one per host, an agent; Rook-Ceph on an extra disk of each; MetalLB in front of Traefik.

hypervisors = {
  hyp00 = { address = "192.0.2.10", pool_dir = "/mnt/virt", network = "ovs:ovs0" }
  hyp01 = { address = "192.0.2.11", pool_dir = "/mnt/virt", network = "ovs:ovs0" }
  hyp02 = { address = "192.0.2.12", pool_dir = "/mnt/virt", network = "ovs:ovs0" }
}

gateway        = "192.0.2.254"
dns            = ["192.0.2.1"]
search_domains = ["example.org"]

machines = {
  cn0 = {
    hypervisor = "hyp00", roles = ["server"], address = "192.0.2.101/16", os = "ubuntu"
    vcpu       = 4, memory_mb = 12288, disk_gb = 60, data_disks = [{ size_gb = 200 }]
    taints     = ["example.org/no-avx2=true:NoSchedule"]
  }
  cn1 = {
    hypervisor = "hyp01", roles = ["server"], address = "192.0.2.102/16"
    vcpu       = 4, memory_mb = 16384, disk_gb = 60, data_disks = [{ size_gb = 200 }]
  }
  cn2 = {
    hypervisor = "hyp02", roles = ["server"], address = "192.0.2.103/16", cpuset = "0-7"
    vcpu       = 4, memory_mb = 16384, disk_gb = 60, data_disks = [{ device = "/dev/disk/by-id/ata-EXAMPLE-SERIAL" }]
  }
  cn3 = {
    hypervisor = "hyp01", roles = ["agent"], address = "192.0.2.104/16"
    vcpu       = 4, memory_mb = 16384, disk_gb = 60, data_disks = [{ size_gb = 200 }]
  }
}

platform = {
  ssh = { private_key_file = "~/.ssh/id_ed25519" }
  network = {
    ca_files = ["~/.ngvm/ca/company-ca.pem"]
  }
  cluster = {
    token_file      = "~/.ngvm/secrets/rke2-token"
    ingress         = "traefik"
    tls_san         = ["k8s.example.org"]
    kubeconfig_file = "~/.kube/ngvm-kvm.yaml"
  }
  addons = {
    storage             = "rook-ceph"
    rook_failure_domain = "chassis"
    issuer              = "ca"
    issuer_name         = "example-ca"
    issuer_ca_cert_file = "~/.ngvm/ca/cluster-ca.pem"
    issuer_ca_key_file  = "~/.ngvm/secrets/cluster-ca.key"
    metallb = {
      addresses  = ["192.0.2.200-192.0.2.220"]
      ingress_ip = "192.0.2.200"
    }
    gitlab_agent = {
      name        = "example"
      kas_address = "wss://gitlab.example.org/-/kubernetes-agent/"
      token_file  = "~/.ngvm/secrets/gitlab-agent-token"
      ca_file     = "~/.ngvm/ca/company-ca.pem"
    }
  }
}
